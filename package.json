{
  "name": "react-native-nitro-image-compressor-monorepo",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/react-native-nitro-image-compressor",
    "example"
  ],
  "scripts": {
    "build": "bun run --cwd packages/react-native-nitro-image-compressor build",
    "specs": "bun run build && bun run --cwd packages/react-native-nitro-image-compressor specs",
    "bootstrap": "bun i && bun run build && cd example && bundle install && bun pods",
    "typecheck": "bun --filter=\"**\" typecheck",
    "lint": "biome check --write",
    "lint-ci": "biome check",
    "format": "biome format --write",
    "clean": "git clean -dfx",
    "release": "release-it",
    "lib": "bun --cwd packages/react-native-nitro-image-compressor",
    "example": "bun --cwd example"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@react-native-community/cli": "^20.2.0",
    "@release-it-plugins/workspaces": "^5.0.3",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^11.0.0",
    "@tsconfig/react-native": "^3.0.9",
    "@types/react": "^19.2.15",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "release-it": "^19.0.4",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@babel/preset-env": "^7.29.7",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true
    },
    "hooks": {
      "before:release": "bun i",
      "after:bump": "scripts/try-install-lockfiles.sh"
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "packages/react-native-nitro-image-compressor/package.json",
            "path": "version"
          },
          {
            "file": "example/package.json",
            "path": "version"
          }
        ]
      },
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "perf",
              "section": "💨 Performance Improvements"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "chore(deps)",
              "section": "🛠️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            }
          ]
        }
      }
    }
  }
}
