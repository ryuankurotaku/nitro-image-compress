{
  "name": "nitro-image-compress",
  "version": "0.1.0",
  "description": "High-performance on-device image compression for React Native using Nitro Modules",
  "type": "module",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "nitrogen",
    "nitro.json",
    "nitro-image-compress.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "specs": "nitro-codegen",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "react-native",
    "nitro",
    "image",
    "compress",
    "resize",
    "jsi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/user/nitro-image-compress"
  },
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "react-native-nitro-modules": "^0.18.0",
    "nitro-codegen": "^0.18.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0",
    "react-native-nitro-modules": ">=0.18.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["commonjs", { "esm": true }],
      "module",
      "typescript"
    ]
  }
}
