{
  "name": "react-native-nitro-image-compressor",
  "version": "0.1.0",
  "description": "High-performance on-device image compression for React Native using Nitro Modules",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "workspaces": [
    "example"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "nitro.json",
    "*.podspec",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf tsconfig.tsbuildinfo && rm -rf lib && bun typecheck && bob build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "release": "release-it",
    "typescript": "tsc",
    "specs": "tsc && nitro-codegen --logLevel=\"debug\""
  },
  "keywords": [
    "react-native",
    "nitro",
    "image",
    "compress",
    "resize",
    "jsi",
    "performance",
    "webp",
    "jpeg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/react-native-nitro-image-compressor.git",
    "directory": "packages/react-native-nitro-image-compressor"
  },
  "author": "Your Name <your@email.com> (https://github.com/user)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/user/react-native-nitro-image-compressor/issues"
  },
  "homepage": "https://github.com/user/react-native-nitro-image-compressor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "nitro-codegen": "^0.18.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "^0.18.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": false,
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": "bun typecheck",
      "after:bump": "bun run build"
    }
  }
}
