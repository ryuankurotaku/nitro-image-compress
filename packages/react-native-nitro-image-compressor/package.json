{
  "name": "react-native-nitro-image-compressor",
  "version": "0.1.1",
  "description": "High-performance on-device image compression for React Native using Nitro Modules",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "nitrogen",
    "android",
    "ios",
    "nitro.json",
    "*.podspec",
    "README.md",
    "!android/build",
    "!android/.cxx"
  ],
  "scripts": {
    "build": "rm -rf tsconfig.tsbuildinfo && rm -rf lib && bun typecheck && bob build",
    "codegen": "tsc && bun --bun nitrogen",
    "specs": "bun run codegen",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib"
  },
  "keywords": [
    "react-native",
    "nitro",
    "nitro-modules",
    "react-native-nitro-modules",
    "image",
    "image-compressor",
    "image-resizer",
    "compress",
    "compression",
    "resize",
    "thumbnail",
    "photo-compression",
    "camera",
    "oom",
    "jsi",
    "performance",
    "new-architecture",
    "fabric",
    "webp",
    "jpeg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuankurotaku/nitro-image-compress.git",
    "directory": "packages/react-native-nitro-image-compressor"
  },
  "author": "Ankur Singh <allen.ankursingh@gmail.com> (https://github.com/ryuankurotaku)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryuankurotaku/nitro-image-compress/issues"
  },
  "homepage": "https://github.com/ryuankurotaku/nitro-image-compress#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "nitrogen": "^0.37.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.37.1",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
